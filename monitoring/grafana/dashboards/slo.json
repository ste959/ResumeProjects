          "expr": "100 * (1 - ((sum(rate(http_server_requests_seconds_count{job=\"oms-backend\",uri!~\"/actuator.*\",status=~\"5..\"}[30d])) / sum(rate(http_server_requests_seconds_count{job=\"oms-backend\",uri!~\"/actuator.*\"}[30d]))) / 0.001))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
