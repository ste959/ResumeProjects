        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_seconds_bucket{job=\"oms-backend\",uri!~\"/actuator.*\",le=\"0.5\"}[30d])) / sum(rate(http_server_requests_seconds_count{job=\"oms-backend\",uri!~\"/actuator.*\"}[30d])))",
