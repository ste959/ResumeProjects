# Alpaca paper-trading credentials for the Quant Desk (Live tab + market data + news).
# Copy this file to `.env` (same directory) and fill in your keys. `.env` is gitignored.
#
# Get keys: sign up at https://alpaca.markets → Paper Trading → API Keys → Generate.
ALPACA_API_KEY=your-key-id
ALPACA_API_SECRET=your-secret-key
ALPACA_PAPER=true
